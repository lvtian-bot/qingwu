@@ -47,12 +47,30 @@
 **     3 You should call RunElevated again (This can happen if a user without admin priv. is used in the runas dialog)
 ** $2: If $0==0 && $1==1: ExitCode of the elevated fork process (The NSIS errlvl is also set)
 ** $3: If $0==0: 1 if the user is a member of the admin group or 0 otherwise
 **/
+# 固定插件至本进程终止，避免 NSIS 清理 DLL 后窗口回调仍指向已卸载代码。
+# 先只查询状态以装载插件，不在固定前创建提权窗口。
+!macro QW_UAC_PinModule
+Push $0
+Push $1
+UAC::_ 3
+System::Call 'kernel32::GetModuleHandleExW(i 1, w "$PLUGINSDIR\UAC.dll", *p .r0) i.r1'
+${If} $1 == 0
+  System::Call 'kernel32::GetLastError() i.r0'
+  SetErrorLevel $0
+  Quit
+${EndIf}
+Pop $1
+Pop $0
+!macroend
+
 !macro UAC_RunElevated
+!insertmacro QW_UAC_PinModule
 UAC::_ 0
 !macroend
