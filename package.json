{
  "name": "qingwu",
  "productName": "青梧",
  "version": "0.0.7",
  "description": "办公 Agent 桌面客户端",
  "author": "Qingwu Authors",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "node -e \"fs.rmSync('out', { force: true, recursive: true })\" && electron-vite build",
    "check": "npm run typecheck && electron-vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "postinstall": "node scripts/patch-dsh.mjs",
    "dist": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "^1.0.1",
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@deepseek-ai/dsh-anonymous-user-id": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-atomic-write": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-bash-local": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-code-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-compaction": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-fs": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-output-retention": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-scope": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session-telemetry": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session-title-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-shell": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-spill": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent-in-process-driver": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-workflow": "^0.1.1-rc.2",
    "electron-updater": "^6.8.9",
    "koffi": "^3.1.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.3",
    "vite": "^6.4.3"
  },
  "build": {
    "appId": "com.qingwu.desktop",
    "productName": "青梧",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json",
      "build/icon.ico",
      "build/icon.png",
      "!**/node_modules/*/{CHANGELOG*,README*,*.md,*.txt}",
      "!**/node_modules/**/*.{map,d.ts,d.mts,d.cts,ts,mts,cts,flow,py,c,cc,h,hh,cpp,hpp,gyp,gypi,ninja,o,obj,pdb,lib,def,s,asm,vcxproj*}",
      "!**/node_modules/**/{test,tests,testing,docs,example,examples,coverage,.github,.vscode,.bin}/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "lvtian-bot",
        "repo": "qingwu"
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "executableName": "qingwu",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "青梧",
      "artifactName": "Qingwu-Setup-${version}.${ext}"
    }
  }
}
